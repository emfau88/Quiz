{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redaktionelle Quizsalon-Frage",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "fact_key": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "nature_animals",
        "geography_travel",
        "everyday_technology",
        "history_discoveries",
        "entertainment",
        "language_culture"
      ]
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": true
      },
      "minItems": 4,
      "maxItems": 4
    },
    "correct_option_id": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "research": {
      "type": "object",
      "properties": {
        "published_on": {"type": "string", "format": "date"},
        "publisher": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1}
      },
      "required": ["published_on", "publisher", "source_id"],
      "additionalProperties": false
    },
    "content_revision": {
      "type": "integer",
      "minimum": 1
    },
    "semantic_revision": {
      "type": "integer",
      "minimum": 1
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "fact_checked",
        "editorially_checked",
        "release_approved",
        "retired"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "format": "uri",
            "pattern": "^https?://"
          },
          "verified_claim": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "verified_claim",
          "checked_at"
        ],
        "additionalProperties": true
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "fact": {
          "type": "object",
          "properties": {
            "actor_type": {
              "enum": [
                "agent",
                "human"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "content_revision": {
              "type": "integer",
              "minimum": 1
            },
            "semantic_revision": {
              "type": "integer",
              "minimum": 1
            },
            "result": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          },
          "required": [
            "actor_type",
            "actor",
            "at",
            "source_ids",
            "content_revision",
            "semantic_revision",
            "result"
          ],
          "additionalProperties": true
        },
        "editorial": {
          "type": "object",
          "properties": {
            "actor_type": {
              "enum": [
                "agent",
                "human"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "content_revision": {
              "type": "integer",
              "minimum": 1
            },
            "semantic_revision": {
              "type": "integer",
              "minimum": 1
            },
            "result": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          },
          "required": [
            "actor_type",
            "actor",
            "at",
            "source_ids",
            "content_revision",
            "semantic_revision",
            "result"
          ],
          "additionalProperties": true
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "length_exception": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "large_text_evidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "reason",
                "large_text_evidence"
              ],
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "human_test_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reference": {
      "type": "boolean"
    },
    "starter": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "fact_key",
    "category",
    "difficulty",
    "question",
    "options",
    "correct_option_id",
    "explanation",
    "tags",
    "content_revision",
    "semantic_revision",
    "valid_until",
    "status",
    "sources",
    "review",
    "human_test_observations"
  ],
  "additionalProperties": true
}
